DATABASE_URL="postgresql://threads:threads@localhost:5433/threads?schema=public"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Local Compose GitLab (--profile gitlab)
GITLAB_URL="http://host.docker.internal:8929"
GITLAB_PUBLIC_URL="http://localhost:8929"
# From: Get-Content scripts/bootstrap-gitlab-oauth.rb | docker compose --profile gitlab exec -T gitlab gitlab-rails runner -
GITLAB_OAUTH_CLIENT_ID=""
GITLAB_OAUTH_CLIENT_SECRET=""
# Optional shared fallback; prefer per-thread "GitLab project" in the UI
GITLAB_PROJECT_ID=""
